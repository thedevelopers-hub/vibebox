# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are added.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical public URL where VIBEBOX is hosted.
# Used for canonical tags, hreflang alternates, sitemap.xml, and Open Graph URLs.
APP_URL="https://vibebox.example"

# GOOGLE_SITE_VERIFICATION: Optional token for Google Search Console HTML tag verification.
GOOGLE_SITE_VERIFICATION="YOUR_GOOGLE_SITE_VERIFICATION_TOKEN"

# ANALYTICS_MEASUREMENT_ID: Optional analytics measurement ID (e.g., GA4 G-XXXXXXXXXX).
ANALYTICS_MEASUREMENT_ID="G-XXXXXXXXXX"
